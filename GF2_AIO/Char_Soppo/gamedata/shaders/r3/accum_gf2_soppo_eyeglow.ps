#include "common.h"
#include "sload.h"


static const float3 EYE_TINT       = float3(1.0, 0.02, 0.03);
static const float  EYE_BRIGHTNESS = 3.0;

float4 main( p_flat I ) : SV_Target
{
	float3 D   = tbase(I.tcdh.xy).rgb;
	D          = SRGBToLinear(D);
	float  lum = max(D.r, max(D.g, D.b));
	return float4(EYE_TINT * lum * EYE_BRIGHTNESS, 0);
}
