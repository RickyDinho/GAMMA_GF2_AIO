#include "common.h"
#include "sload.h"

// GF2 eye-glow: glowing iris for gf2_soppo (glow pass of models_gf2_soppo_eyeglow.s).
// [AUTO-GENERATED by build.py from GF2_AIO_source/shaders/accum_eyeglow.ps --
// edit the template, not this file. Tint/brightness come from her gf2_eyeglow LTX.]
// The stock accum_emissive returns alpha 16, which the combine pass uses to
// add the surface color at 16x -- a saturated color then clips and tonemaps
// to yellow/white. Here alpha is 0 and the light is emitted directly: the
// iris texture's brightness (keeps the pupil/iris pattern) times a fixed
// tint, so the texture's own color can't shift the hue.

static const float3 EYE_TINT       = float3(1.0, 0.02, 0.03);
static const float  EYE_BRIGHTNESS = 3.0;

float4 main( p_flat I ) : SV_Target
{
	float3 D   = tbase(I.tcdh.xy).rgb;
	D          = SRGBToLinear(D);
	float  lum = max(D.r, max(D.g, D.b));
	return float4(EYE_TINT * lum * EYE_BRIGHTNESS, 0);
}
