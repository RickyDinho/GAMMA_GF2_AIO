-- GF2 AIO -- runtime logic  [hand-editable; data tables are in the generated header above]
-- This file is appended to the generated GF2_CHARS/GF2_FACTION_SMART header by build.py.

-- Initialise per-character mutable state
for _, data in pairs(GF2_CHARS) do
    data._state = {
        snd            = {},
        last_snd       = nil,
        in_combat      = false,
        combat_end_t   = 0,
        last_assault_t = 0,
        last_hit_t     = 0,
    }
end

-- ── Config reader ─────────────────────────────────────────────────────────────
local _cfg_ini = false   -- false = not yet attempted, nil = file missing
local function _get_cfg()
    if _cfg_ini == false then
        if getFS():exist("$game_config$", "gf2_aio_config.ltx") then
            _cfg_ini = ini_file("gf2_aio_config.ltx")
        else
            _cfg_ini = nil
        end
    end
    return _cfg_ini
end

local _faction_cache = {}
local _char_cfg_cache = {}
local function _get_char_cfg(char_name)
    if _char_cfg_cache[char_name] ~= nil then return _char_cfg_cache[char_name] end
    local fname = "gf2_char_" .. char_name .. ".ltx"
    local result = getFS():exist("$game_config$", fname) and ini_file(fname) or false
    _char_cfg_cache[char_name] = result
    return result
end

local function gf2_get_faction(section)
    if _faction_cache[section] then return _faction_cache[section] end
    local cfg      = _get_cfg()
    local f        = cfg and cfg:r_string_ex(section, "faction")
    local hardcoded = GF2_CHARS[section].faction
    -- 1. Explicit post-install user edit in main config (differs from hardcoded default).
    if f and f ~= "" and f ~= hardcoded then
        _faction_cache[section] = f
        return f
    end
    -- 2. Per-char FOMOD config file installed by the installer (gf2_char_<name>.ltx).
    --    This is the authoritative source for FOMOD per-character faction selections.
    local char_name = section:match("^gf2_(.+)$")
    if char_name then
        local char_cfg = _get_char_cfg(char_name)
        local cf = char_cfg and char_cfg:r_string_ex(section, "faction")
        if cf and cf ~= "" then
            _faction_cache[section] = cf
            return cf
        end
    end
    -- 3. Squad player_id set by squad_descr on engine init.
    local data = GF2_CHARS[section]
    if data then
        local se = data.squad_id and get_story_se_object(data.squad_id)
        if se and se.player_id and se.player_id ~= "" then
            _faction_cache[section] = se.player_id
            return se.player_id
        end
    end
    -- 4. Fallback: config value or hardcoded default.
    local result = (f and f ~= "") and f or hardcoded
    _faction_cache[section] = result
    return result
end

local function gf2_get_smart_name(section)
    return GF2_FACTION_SMART[gf2_get_faction(section)]
end

-- ── Sound system ──────────────────────────────────────────────────────────────
local function gf2_play_snd(data, path)
    local st = data._state
    if st.last_snd then
        local prev = st.snd[st.last_snd]
        if prev and prev:playing() then prev:stop() end
    end
    st.last_snd = path
    if not st.snd[path] then
        st.snd[path] = sound_object(path)
        if not st.snd[path] then
            printf("gf2_aio: ERROR failed to create sound [%s]", path)
            return
        end
    end
    st.snd[path]:play(db.actor, 0, sound_object.s2d)
end

-- ── NPC lookup ────────────────────────────────────────────────────────────────
local function gf2_get_npc(data)
    local se = get_story_se_object(data.squad_id)
    if not se then return nil end
    for k in se:squad_members() do
        local obj = db.storage[k.id] and db.storage[k.id].object
        if obj and obj:alive() then return obj end
    end
    return nil
end

-- ── Smart terrain capacity ────────────────────────────────────────────────────
local function gf2_ensure_smart_capacity()
    -- Count how many GF2 squads will SPAWN at each smart (faction-based, not per-char
    -- home smart) so we raise capacity on the right terrains before create_squad runs.
    local counts = {}
    for section, _ in pairs(GF2_CHARS) do
        local sname = GF2_FACTION_SMART[gf2_get_faction(section)]
        if sname then counts[sname] = (counts[sname] or 0) + 1 end
    end

    for sname, gf2_count in pairs(counts) do
        local smart = SIMBOARD.smarts_by_names[sname]
        if not smart then
            printf("gf2_aio: [capacity] ERROR missing smart [%s] (needed by %s GF2 squad(s))", sname, tostring(gf2_count))
        else
            -- squad_capacity: assignment limit (nil = uncapped — leave it alone if nil,
            --   only raise if it was already a finite number that's too small)
            -- max_population: online NPC limit (must accommodate vanilla squads + GF2 squads,
            --   so target = original value + gf2_count, NOT a flat number)
            local cap_before    = smart.squad_capacity
            local maxpop_before = smart.max_population
            local needed_online = (maxpop_before or 0) + gf2_count * 2

            if cap_before ~= nil and cap_before < (gf2_count + 2) then
                smart.squad_capacity = gf2_count + 2
            end
            if (maxpop_before or 0) < needed_online then
                smart.max_population = needed_online
            end
        end
    end
end

-- ── Spawn ─────────────────────────────────────────────────────────────────────
local function gf2_spawn_char(section, data)
    local init_info = section .. "_init"

    -- Squad existence is the authoritative check. The info flag can be set during
    -- the pre-load pass of a new game while entities are still being wiped, so
    -- relying on it alone causes the NPC to never appear on the actual world load.
    local existing = get_story_se_object(data.squad_id)
    if existing then
        if not has_alife_info(init_info) then give_info(init_info) end
        local faction = gf2_get_faction(section)
        if existing.player_id ~= faction then
            existing.player_id = faction
            SIMBOARD:setup_squad_and_group(existing)
        end
        local smart_name = GF2_FACTION_SMART[faction]
        local target_smart = smart_name and SIMBOARD.smarts_by_names[smart_name]
        if target_smart and existing.assigned_target_id ~= target_smart.id then
            SIMBOARD:assign_squad_to_smart(existing, target_smart)
        end
        return
    end

    local faction    = gf2_get_faction(section)
    local smart_name = GF2_FACTION_SMART[faction]   -- spawn at faction-territory smart
    local smart      = smart_name and SIMBOARD.smarts_by_names[smart_name]
    if not smart then
        printf("gf2_aio: [spawn] ERROR smart [%s] not found for [%s]", tostring(smart_name), section)
        return
    end

    local squad = SIMBOARD:create_squad(smart, data.squad_id)
    if squad then
        if squad.player_id ~= faction then
            squad.player_id = faction
            SIMBOARD:setup_squad_and_group(squad)
        end
        give_info(init_info)
    else
        printf("gf2_aio: [spawn] ERROR create_squad returned nil for [%s]", section)
    end
end

local function gf2_spawn_all()
    gf2_ensure_smart_capacity()
    for section, data in pairs(GF2_CHARS) do
        gf2_spawn_char(section, data)
    end
end

-- ── Net spawn — invulnerability ───────────────────────────────────────────────
local function gf2_on_net_spawn(npc, se_obj)
    if npc and GF2_CHARS[npc:section()] then
        npc:invulnerable(true)
    end
end

local function gf2_on_before_hit(npc, shit, bone_id, flags)
    if npc and GF2_CHARS[npc:section()] then
        flags.ret_value = false
    end
end

-- ── Death / kill barks ────────────────────────────────────────────────────────
local function gf2_on_death(npc, killer)
    if not npc then return end
    local data = GF2_CHARS[npc:section()]
    if data then
        gf2_play_snd(data, data.sounds.death)
        return
    end
    if killer then
        local kdata = GF2_CHARS[killer:section()]
        if kdata then gf2_play_snd(kdata, kdata.sounds.kill) end
    end
end

-- ── Hit bark ──────────────────────────────────────────────────────────────────
local function gf2_on_hit(victim, amount, direction, who, bone_index)
    if not (who and victim) then return end
    local data = GF2_CHARS[who:section()]
    if not data then return end
    if not (victim:alive() and amount > 0) then return end
    local now = time_global()
    local cd  = data.hit_cooldown
    if cd == 0 or (now - data._state.last_hit_t) > cd then
        data._state.last_hit_t = now
        gf2_play_snd(data, data.sounds.hit)
    end
end

-- ── Combat state machine ──────────────────────────────────────────────────────
local _melee_patched = false

local function gf2_on_update()
    if not _melee_patched then gf2_patch_melee() end

    local now = time_global()
    for section, data in pairs(GF2_CHARS) do
        local npc = gf2_get_npc(data)
        if npc and npc:has_info("npcx_is_companion") then
            local st        = data._state
            local has_enemy = npc:best_enemy() ~= nil

            if has_enemy then
                st.combat_end_t = now + data.combat_end_delay
                if not st.in_combat then
                    st.in_combat = true
                    gf2_play_snd(data, data.sounds.combat_start)
                else
                    local state = state_mgr and state_mgr.get_state(npc)
                    if state == "assault" or state == "hide_fire" or state == "run_fire" then
                        if now - st.last_assault_t > data.assault_cooldown then
                            st.last_assault_t = now
                            gf2_play_snd(data, data.sounds.assault)
                        end
                    end
                end
            else
                if st.in_combat and now > st.combat_end_t then
                    st.in_combat      = false
                    st.last_assault_t = 0
                    gf2_play_snd(data, data.sounds.combat_end)
                end
            end
        end
    end
end

-- ── Melee GOAP patch (any character with melee = true) ───────────────────────
function gf2_patch_melee()
    local idiots = idiots_combat_assault
    if not idiots then return end
    local cls = idiots.action_combat_assault
    if not cls then
        printf("gf2_aio: [melee] ERROR module loaded but class not found")
        _melee_patched = true   -- permanent failure: stop retrying (and re-logging) every update
        return
    end

    local POS  = require "illish.lib.pos"
    local UTIL = require "illish.lib.util"

    local orig_initConfig  = cls.initConfig
    local orig_push        = cls.push
    local orig_updateState = cls.updateState

    local ok1 = pcall(function()
        cls.initConfig = function(self)
            orig_initConfig(self)
            local sec = self.object and self.object:section()
            if sec and GF2_CHARS[sec] and GF2_CHARS[sec].melee then
                self.st.config.zones.melee = {0.5, 1.0, 1.5, 2.0}
            end
        end
    end)

    local ok2 = pcall(function()
        cls.push = function(self)
            local sec = self.object and self.object:section()
            if not (sec and GF2_CHARS[sec] and GF2_CHARS[sec].melee) then
                orig_push(self)
                return
            end
            local state = self.st.state
            local enemy = self.st.enemy
            if state.reached and not state.expires then
                state.expires = time_plus_rand(150, 300)
            end
            if not state.vid then
                local dir = vec_rot_range(enemy.dir, 180)
                local pos = vec_offset(enemy.pos, dir, UTIL.random(1.0, 1.5, 1))
                state.vid = POS.bestOutsideUnclaimedLVID(self.object, self.object:position(), pos)
            end
        end
    end)

    local ok3 = pcall(function()
        cls.updateState = function(self)
            orig_updateState(self)
            local sec = self.object and self.object:section()
            if sec and GF2_CHARS[sec] and GF2_CHARS[sec].melee then
                local state = self.st.state
                local enemy = self.st.enemy
                if enemy.id and not state.grenades and not self.st.movePoint then
                    state.action = "push"
                end
            end
        end
    end)

    if not (ok1 and ok2 and ok3) then
        printf("gf2_aio: [melee] ERROR patch failed (ok1=%s ok2=%s ok3=%s)",
            tostring(ok1), tostring(ok2), tostring(ok3))
    end
    _melee_patched = true   -- done either way; a failed pcall won't succeed on retry
end

-- ── Dismiss / recruit helpers ─────────────────────────────────────────────────
local function gf2_dismiss(section, data, actor, npc)
    gf2_play_snd(data, data.sounds.dismiss)
    dialogs_axr_companion.remove_companions_from_squad(actor, npc)

    local squad = get_object_squad(npc)
    if not squad then
        local se = get_story_se_object(data.squad_id)
        if se then squad = alife_object(se.id) end
    end

    if squad then
        local smart_name = gf2_get_smart_name(section)
        local smart      = smart_name and SIMBOARD.smarts_by_names[smart_name]
        if smart then
            squad.assigned_target_id = smart.id
            squad.scripted_target    = nil
            SIMBOARD:setup_squad_and_group(squad)
        else
            printf("gf2_aio: ERROR home smart [%s] not found on dismiss for [%s]",
                tostring(smart_name), section)
        end
    else
        printf("gf2_aio: WARNING squad not found on dismiss for [%s]", section)
    end
end

local function gf2_recruit(data, actor, npc)
    gf2_play_snd(data, data.sounds.recruit)
    dialogs_axr_companion.become_actor_companion(actor, npc)
end

-- ── Callbacks ─────────────────────────────────────────────────────────────────
function on_game_start()
    RegisterScriptCallback("actor_on_first_update", gf2_spawn_all)
    RegisterScriptCallback("npc_on_net_spawn",      gf2_on_net_spawn)
    RegisterScriptCallback("npc_on_death_callback", gf2_on_death)
    RegisterScriptCallback("actor_on_update",       gf2_on_update)
    RegisterScriptCallback("npc_on_hit_callback",   gf2_on_hit)
    RegisterScriptCallback("npc_on_before_hit",     gf2_on_before_hit)
end

-- ── Public dialog API ─────────────────────────────────────────────────────────
-- Dialog XMLs call gf2_aio.gf2_[char]_play_xxx / gf2_[char]_recruit_companion etc.
-- Standard functions are registered for every character.
-- Optional sound keys (anything not in the core combat set) get _play_<key>_line
-- automatically, so new dialog sounds need no code changes here.
-- Per-character dialog functions are generated by build.py and appended after this
-- file. They appear as top-level declarations (not _G[] assignments) so that
-- STALKER's module sandbox exposes them correctly as gf2_aio.<func>.


