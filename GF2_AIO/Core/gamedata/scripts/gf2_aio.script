    function gf2_tololo_play_greet_line(a, n)      gf2_play_snd(_d, _s.greet)   end
    function gf2_tololo_recruit_companion(a, n)    gf2_recruit(_d, a, n)         end
    function gf2_tololo_dismiss_companion(a, n)    gf2_dismiss("gf2_tololo", _d, a, n) end
    function gf2_tololo_play_misc_line(a, n)    gf2_play_snd(_d, _s.misc) end
end

do  -- vector
    local _d = GF2_CHARS["gf2_vector"]
    local _s = _d.sounds
    function gf2_vector_play_first_meet_line(a, n) gf2_play_snd(_d, _s.intro)   end
    function gf2_vector_play_greet_line(a, n)      gf2_play_snd(_d, _s.greet)   end
    function gf2_vector_recruit_companion(a, n)    gf2_recruit(_d, a, n)         end
    function gf2_vector_dismiss_companion(a, n)    gf2_dismiss("gf2_vector", _d, a, n) end
    function gf2_vector_play_misc_line(a, n)    gf2_play_snd(_d, _s.misc) end
end
