-- GF2 AIO -- unified XML injector  [AUTO-GENERATED by build.py -- do not edit]

function on_xml_read()
    RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)

        -- Portrait icons
        if xml_file_name == [[configs\ui\textures_descr\ui_actor_portrets.xml]] then
            local chars = {
                "alva",
                "basti",
                "cheeta",
                "groza",
                "helen",
                "klukai",
                "leva",
                "lind",
                "makiatto",
                "mosin",
                "nikketa",
                "phaetusa",
                "robella",
                "tina",
                "tololo",
                "vector",
            }
            for _, name in ipairs(chars) do
                local icon_xml = string.format([[configs\ui\textures_descr\ui_icon_gf2_%s.xml]], name)
                if getFS():exist("$game_config$", icon_xml) then
                    xml_obj:insertFromXMLFile(icon_xml, nil, nil, true)
                end
            end
            return
        end

        -- Dialogs: each character injects into the XML file for their home zone
        local dialog_map = {
            ["gameplay\\dialogs_escape.xml"] = { "alva", "basti", "cheeta", "groza", "helen", "klukai", "leva", "lind", "makiatto", "mosin", "nikketa", "phaetusa", "robella", "tina", "tololo", "vector" },
        }

        local chars_for_file = dialog_map[xml_file_name]
        if not chars_for_file then return end

        for _, name in ipairs(chars_for_file) do
            local dialog_xml = string.format([[gameplay\dialogs_gf2_%s.xml]], name)
            if getFS():exist("$game_config$", dialog_xml) then
                xml_obj:insertFromXMLFile(dialog_xml, nil, nil, true)
            end
        end

    end)
end
